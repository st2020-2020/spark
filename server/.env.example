SPARK_ENV=development
SPARK_ADDR=127.0.0.1:8080
SPARK_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://spark:CHANGE_ME@127.0.0.1:54329/spark_dev?sslmode=disable
# Separate random values: openssl rand -base64 32
SPARK_SECRET=
SPARK_ENCRYPTION_KEY=
# Local development mailbox. Production defaults to disabled.
SPARK_MAIL_MODE=development
# For SMTP, set smtp on both the API and /spark-worker mail.
# Configure these settings only on the mail Worker.
# SPARK_SMTP_HOST=
# SPARK_SMTP_TLS=implicit
# SPARK_SMTP_PORT=465
# SPARK_SMTP_FROM=
# SPARK_SMTP_CREDENTIALS_FILE=/run/secrets/spark-smtp-credentials.json
# SPARK_SMTP_CA_FILE=/run/spark-smtp/test-ca.pem
# Compose bind source for the read-only credential file.
# SPARK_SMTP_CREDENTIALS_HOST_PATH=../server/.local/smtp-credentials.json
# For Tencent SES, set tencent-ses on both the API and /spark-worker mail.
# Inject these settings and the read-only credentials file only into the mail Worker.
# SPARK_SES_REGION=ap-guangzhou
# SPARK_SES_FROM=
# SPARK_SES_REGISTER_TEMPLATE_ID=
# SPARK_SES_RESET_TEMPLATE_ID=
# SPARK_SES_CREDENTIALS_FILE=/run/secrets/spark-ses-credentials.json
# Used only by deploy/compose.dev.yaml
SPARK_DEV_DB_PASSWORD=
# AI text organization is disabled by default
# SPARK_AI_ENABLED=false
# SPARK_AI_CONFIG_HOST_PATH=../server/.local/ai-routes.json
# Private OSS attachments are disabled by default. Use oss-v2 with a private read-only platform credential file.
# Default host credential path: /etc/spark/oss/credentials.json
# SPARK_OSS_ENABLED=false
# SPARK_OSS_CONFIG_HOST_PATH=../server/.local/oss-config.json
# SPARK_OSS_CREDENTIALS_HOST_PATH=../server/.local/oss-credentials.json
# Link preview is disabled until its outbound network policy is approved.
# SPARK_URL_EXTRACT_ENABLED=false
# Permanent deletion is disabled until the independent ledger is configured.
# SPARK_PURGE_ENABLED=false
# SPARK_DELETION_LEDGER_HOST_PATH=/var/lib/spark-deletion-ledger

# Optional standalone image analysis. The provider secret is a read-only worker file.
SPARK_IMAGE_ANALYSIS_ENABLED=false
# SPARK_IMAGE_ANALYSIS_KEY_HOST_PATH=/etc/spark/image-analysis/api-key
