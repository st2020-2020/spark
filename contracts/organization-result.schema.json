{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spark 自动整理输出 v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "tag_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "tag_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/definitions/Evidence"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "maxItems": 3
    },
    "project_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidence": {
            "$ref": "#/definitions/Evidence"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "project_id",
          "reason",
          "evidence",
          "confidence"
        ]
      },
      "maxItems": 5
    },
    "topic_candidate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "evidence": {
          "$ref": "#/definitions/Evidence"
        }
      },
      "required": [
        "name",
        "reason",
        "evidence"
      ]
    }
  },
  "required": [
    "title",
    "tag_candidates",
    "project_candidates"
  ],
  "definitions": {
    "Evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "source_id",
          "quote"
        ]
      },
      "minItems": 1,
      "maxItems": 5
    }
  }
}
