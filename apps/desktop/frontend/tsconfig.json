{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": { "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"] },
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
